<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="BestReview">

	<!-- 등록 -->
	<insert id="insert" parameterType="BestReview">
		insert into bestreview(review_id)
		values (#{review_id})
		
		<selectKey keyColumn="bestreview_id" resultType="int" order="AFTER" keyProperty="bestreview_id">
			select last_insert_id() as bestreview_id
		</selectKey>
	</insert>
	
	<!-- review 정보 가져오기 -->
	<resultMap type="BestReview" id="BestReviewMap">
		<id property="bestreview_id" column="bestreview_id" />
		<result property="review_id" column="review_id"/>
		
		<association property="review" column="review_id" javaType="Review" select="Review.selectById"> </association>
	</resultMap>
	
	<!-- 공통 sql -->
	<sql id="sql_select">
		select bestreview_id, review_id from bestreview
	</sql>
	
	<!-- 전체 조회 -->
	<select id="selectAll" resultMap="BestReviewMap">
		<include refid="sql_select"></include>
		order by bestreview_id desc
	</select>
	
	<!-- 삭제 -->
	<delete id="delete">
		delete from bestreview where bestreview_id = #{bestreview_id}
	</delete>
</mapper>