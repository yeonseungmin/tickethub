<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="HotWork">

	<!-- 등록 -->
	<insert id="insert" parameterType="HotWork">
		insert into hotwork(work_id)
		values (#{work_id})
		
		<selectKey keyColumn="hotwork_id" resultType="int" order="AFTER" keyProperty="hotwork_id">
			select last_insert_id() as hotwork_id
		</selectKey>
	</insert>
	
	<resultMap type="HotWork" id="HotWorkMap">
		<id property="hotwork_id" column="hotwork_id"/>
		<result property="work_id" column="work_id" />
		
		<association column="work_id" property="work" javaType="Work" select="Work.select"></association>
	</resultMap>
	
	<!-- 공통 sql -->
	<sql id="sql_select">
		select hotwork_id, work_id from hotwork
	</sql>
	
	<!-- 전체 조회 -->
	<select id="selectAll" resultMap="HotWorkMap">
		<include refid="sql_select"></include>
		order by hotwork_id desc
	</select>
	
	<!-- 삭제 -->
	<delete id="delete">
		delete from hotwork where hotwork_id = #{hotwork_id}
	</delete>
	
</mapper>
